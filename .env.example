# Copy to .env.local and fill in. Never commit real values.
# All variables are read on the server only. None are prefixed with NEXT_PUBLIC_.

# --- Required ---
# Postgres 15+ with the pgvector extension available (Supabase/Neon both work).
# Use the pooled connection string for the app and the direct one for migrations if your host distinguishes them.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/support_pilot
# Optional: connection pool size (default 10). Use 1 for a single-session local PGlite server.
DATABASE_POOL_MAX=

# --- Optional ---
# debug | info | warn | error (default: info, or debug in development)
LOG_LEVEL=

# REQUIRED. Signs session cookies. At least 32 chars. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public base URL. Required in production; defaults to http://localhost:3000 in development.
BETTER_AUTH_URL=http://localhost:3000

# --- Claude ---
# Claude API key (server only). Optional: without it the app runs free (keyword triage, template
# drafts, search-only answers; see README "Free mode"). Needed by "npm run seed:generate".
ANTHROPIC_API_KEY=
# Optional: model used by the seed generator (default: claude-sonnet-5-5).
SEED_MODEL=
# Optional: model for ticket triage and "npm run eval:triage" (default: claude-opus-5-5).
TRIAGE_MODEL=

# --- Outbound email (optional) ---
# Resend API key. When set, agent replies are emailed to customers by the job worker.
RESEND_API_KEY=
# Sender address on a domain verified in Resend. Required with RESEND_API_KEY.
EMAIL_FROM=

# --- Demo (optional, demo data) ---
# Password of the demo accounts from "npm run db:seed:demo". When set, the login page shows
# "Try as Guest" (read-only demo viewer). Leave empty on any deployment with real users.
DEMO_USER_PASSWORD=

# Embeddings need no key: they run locally (multilingual-e5-small, downloaded on first use).
# Optional: "off" = keyword search only, no local model.
SEMANTIC_SEARCH=
# Optional: absolute download folder for the model (default: <app>/.cache/transformers).
# Serverless hosts such as Vercel only allow writes under /tmp: use /tmp/transformers there.
MODEL_CACHE_DIR=

# --- Docker Compose only (optional) ---
# Compose ignores DATABASE_URL above and uses its bundled Postgres.
POSTGRES_PASSWORD=
# Host ports. Postgres is bound to 127.0.0.1 only.
POSTGRES_PORT=
APP_PORT=
